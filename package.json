{
  "name": "baihua-dsh-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "Baihua (百花) <-> DeepSeek Harness bridge plugin. Exposes an HTTP + WebSocket surface on DSH's webServer so Baihua Web can create/resume agent sessions and stream session events (streaming tokens, tool call timeline) back in real time.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "baihua",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.7"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^0.1.0-rc.7",
    "ws": "^8.0.0"
  },
  "scripts": {
    "chore": "true"
  }
}
